# Copiar a .env (NO subir .env a GitHub) y reemplazar cada clave por una propia.
# Iniciar_CanariApp.cmd lo genera solo con claves aleatorias.
POSTGRES_PASSWORD=cambiar_clave_dueno_bd
DB_PASSWORD=cambiar_clave_rol_app
# JWT_SECRET: obligatorio, 32 caracteres o más (la API no arranca sin él)
JWT_SECRET=cambiar_por_texto_largo_aleatorio_de_32_o_mas_caracteres
# Clave para cifrar los respaldos (.sql.enc). 32+ caracteres. GUÁRDELA FUERA DEL PC:
# sin ella no se pueden restaurar los respaldos.
BACKUP_ENCRYPTION_KEY=cambiar_por_otra_clave_larga_aleatoria_32_o_mas
ADMIN_EMAIL=admin@canariapp.cl
ADMIN_PASSWORD=cambiar_clave_admin

# 1 = carga las 7 mutaciones "propuesta" de BaseDatos/catalogo/mutacion.csv (solo demo; el cliente aún no las valida)
SEED_MUTACIONES_PROPUESTA=1

WEB_PORT=8080
API_PORT=8081
DB_HOST_PORT=5433
# 127.0.0.1 = solo este PC ; 0.0.0.0 = visible para otros equipos de la misma red wifi
BIND_ADDRESS=127.0.0.1
APP_DEBUG=false

# ---- Respaldo de Neon (servicio respaldo-neon, perfil "neon") ----
# Datos en Neon > proyecto > Connect. Use el host DIRECTO (sin "-pooler").
# docker compose --profile neon up -d --build respaldo-neon
NEON_DB_HOST=
NEON_DB_PORT=5432
NEON_DB_NAME=neondb
# Rol de la aplicación (el mismo DB_USER/DB_PASSWORD configurado en Vercel)
NEON_DB_USER=canariapp
NEON_DB_PASSWORD=
# Dueño de las tablas en Neon (solo para restaurar)
NEON_DB_OWNER_USER=neondb_owner
NEON_DB_OWNER_PASSWORD=
# Opcional: clave distinta para los respaldos de Neon (si se deja vacía usa BACKUP_ENCRYPTION_KEY)
NEON_BACKUP_ENCRYPTION_KEY=
