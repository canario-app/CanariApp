# Aplicación
APP_NAME=CanariApp
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_TIMEZONE=America/Santiago

# Base de datos (PostgreSQL)
# Si estas en local, usa 'localhost' y para docker usa 'db'
DB_HOST=localhost
DB_PORT=5432
DB_NAME=canariapp_db
DB_USER=canariapp
DB_PASSWORD=canariapp_password

# Credenciales de propietario de tablas para restaurar respaldos con psql (RF029)
DB_RESTORE_USER=postgres
DB_RESTORE_PASS=

# Neon exige SSL: DB_SSLMODE=require (vacío en local)
DB_SSLMODE=

# Seguridad / JWT (obligatorio, 32 caracteres o más; no hay valor por defecto)
JWT_SECRET=
JWT_EXPIRATION=1800

# Clave de cifrado de respaldos .sql.enc (obligatoria para generar/restaurar, 32+ caracteres)
BACKUP_ENCRYPTION_KEY=